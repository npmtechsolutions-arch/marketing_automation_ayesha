# Frontend development settings. Copy to `frontend/.env` and edit as needed;
# both of these are optional and the defaults suit a standard local setup.

# Where the Vite dev server proxies /api to. Set this when the backend is not
# on port 8000 -- for example when another project is already using it. The
# app itself always calls /api/v1 on its own origin in development, so this is
# the single place the backend's port is configured.
# VITE_PROXY_TARGET=http://localhost:8001

# An absolute API base, which bypasses the proxy entirely. Takes precedence
# over VITE_PROXY_TARGET. Use for a deployed API or a tunnel, not for local
# work -- an absolute cross-origin base brings CORS back with it.
# VITE_API_URL=https://api.example.com/api/v1
