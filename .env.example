# MarketEngine AI — environment template
#
# Copy to .env at the repository root and fill in real values:
#     cp .env.example .env
#
# The backend loads this file from the repo root (see backend/app/core/config.py,
# `env_path`). .env is gitignored; .env.example is committed. Never put a real
# secret in this file.
#
# Every variable below has a default in config.py — an empty value means the
# feature is simply disabled, so a local run needs only DEBUG, DATABASE_URL and
# the two secrets.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_NAME="MarketEngine AI"
VERSION="1.0.0"
# Leave true for local development. With DEBUG=false the app refuses to start
# while SECRET_KEY/JWT_SECRET_KEY are still placeholders.
DEBUG=true

# ---------------------------------------------------------------------------
# Auth / JWT  (required)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Data stores  (required)
# ---------------------------------------------------------------------------
# Must use the asyncpg driver. The docker-compose value is:
#   postgresql+asyncpg://postgres:postgres@postgres:5432/marketengine
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketengine
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Concurrency / performance
# ---------------------------------------------------------------------------
# Max simultaneous publishes to social platforms.
MAX_CONCURRENT_PUBLISHES=5
# Thread pool for blocking work (password hashing, ffmpeg, blocking HTTP).
# Keep comfortably above MAX_CONCURRENT_PUBLISHES so logins are never starved.
PUBLISH_THREAD_POOL_SIZE=16
# Days a soft-deleted user is retained before the scheduled hard purge.
SOFT_DELETE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# AI providers  (optional — content generation is disabled when unset)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Stripe billing  (optional)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Lets an admin switch plan without paying. Development/demo only — never
# enable in production, it hands out paid tiers for free.
BILLING_ALLOW_MANUAL_PLAN_CHANGE=false

# ---------------------------------------------------------------------------
# Meta (Facebook / Instagram) OAuth
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_REDIRECT_URI=http://localhost:8000/api/v1/facebook/callback
META_WEBHOOK_VERIFY_TOKEN=marketengine_verify_token

# ---------------------------------------------------------------------------
# LinkedIn OAuth
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must EXACTLY match the "Authorized redirect URL" in the LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/callback

# ---------------------------------------------------------------------------
# Google / YouTube OAuth + Firebase
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Firebase project backing the frontend Google sign-in popup. The backend
# verifies each ID token's signature, issuer and audience against this project.
FIREBASE_PROJECT_ID=marketengine-ai
# Must EXACTLY match an "Authorized redirect URI" in the Google OAuth client.
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback

# ---------------------------------------------------------------------------
# X / Twitter OAuth
# ---------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Must EXACTLY match a "Callback URI" in the X app's user authentication settings.
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/twitter/callback

# ---------------------------------------------------------------------------
# AWS S3 media storage  (optional — local disk is used when unset)
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Set for S3-compatible services (MinIO, R2); leave blank for AWS.
S3_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Email  (optional)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
FROM_EMAIL=noreply@example.com

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
# Automatically added to the allowed CORS origins.
FRONTEND_URL=http://localhost:5173
# Extra allowed origins as a JSON array. localhost:5173, 127.0.0.1:5173 and
# localhost:3000 are always allowed, so this is only for additional hosts.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------------------
# Frontend build-time variable
# ---------------------------------------------------------------------------
# Read by Vite, so it belongs in frontend/.env — not this file. Defaults to
# http://localhost:8000/api/v1 when unset.
# VITE_API_URL=http://localhost:8000/api/v1
